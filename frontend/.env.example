# URL base de la API (backend PHP, docs/api.md). Sin esta variable:
# - npm run dev usa http://localhost:8000/api/v1 (composer serve en backend/);
# - npm run build usa /api/v1 (mismo dominio que la API en Hostinger, public_html/api/).
# Cópialo como .env.local solo si necesitas otra URL. Plan B (API en Render), al compilar desde PowerShell:
#   $env:VITE_API_URL='https://<servicio>.onrender.com/api/v1'; npm run build
# Ojo: no pongas VITE_API_URL=http://localhost... en .env.local si vas a compilar para producción (.env.local
# también se usa en npm run build); el empaquetado del backend rechaza ese build.
VITE_API_URL=

# Login con Google (RF-17, DEC-B61): ID de cliente OAuth "Aplicación web" de Google Cloud (el mismo GOOGLE_CLIENT_ID
# del backend; ver docs/deployment.md). Vacío = no se muestra el botón "Iniciar sesión con Google". No es un secreto.
VITE_GOOGLE_CLIENT_ID=
