# public_html/assets/ (auditoría A-03, RNF-06). Vite genera los JS y CSS con un hash en el nombre
# (p. ej. index-D_sFebZa.js): si el contenido cambia, cambia el nombre, así que se pueden guardar un año sin
# revalidar. Las imágenes de assets/proyectos/ no llevan hash: caché de una semana.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
