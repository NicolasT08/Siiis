# Copia este archivo como backend/.env y completa los valores. Nunca versiones el .env real.
# En Hostinger, el .env vive fuera de public_html (ver docs/deployment.md).

# Aplicación
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGO_URI=
MONGO_DB_NAME=siiis
# Base exclusiva para pruebas de integración (nunca debe ser "siiis")
MONGO_DB_NAME_TEST=siiis_test

# JWT / sesión (JWT_SECRET: mínimo 32 caracteres; JWT_TTL_SECONDS se recorta a 28800 = 8 h)
JWT_SECRET=
JWT_TTL_SECONDS=28800

# Login y contraseñas
MAX_LOGIN_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TTL_MINUTES=30
# TODO_SPEC: ruta definitiva de la pantalla de restablecimiento en el frontend
PASSWORD_RESET_URL=http://localhost:5173/restablecer

# Rate limiting (por IP, en storage/ratelimit/)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_FORGOT_WINDOW_SECONDS=3600

# Home
HOME_MAX_ITEMS=20

# Perfil de usuario (DEC-B21, provisionales)
PERFIL_NOMBRE_MAX_LENGTH=80
PERFIL_PROGRAMA_MAX_LENGTH=120
PERFIL_BIOGRAFIA_MAX_LENGTH=1000
PERFIL_SEMESTRE_MAX=10
PERFIL_TELEFONO_MIN_DIGITS=7
PERFIL_TELEFONO_MAX_DIGITS=20
# Foto de perfil: JPEG, PNG o WebP de hasta 2 MB (2097152 bytes)
PERFIL_FOTO_MAX_BYTES=2097152

# Listado de integrantes GET /users (DEC-B26, provisionales)
USERS_PER_PAGE_DEFAULT=20
USERS_PER_PAGE_MAX=50

# Contenido: proyectos, artículos y noticias (fase 3; DEC-B37, DEC-B38 y DEC-B41, provisionales)
DOCUMENTOS_PER_PAGE_DEFAULT=12
DOCUMENTOS_PER_PAGE_MAX=50
DOCUMENTO_TITULO_MAX_LENGTH=200
DOCUMENTO_DESCRIPCION_MAX_LENGTH=1000
# contenido en Markdown (DEC-B37)
DOCUMENTO_CONTENIDO_MAX_LENGTH=50000
DOCUMENTO_INTEGRANTES_MAX=20
# Adjuntos (DEC-B40 y DEC-B42): imágenes JPEG, PNG o WebP de hasta 5 MB (5242880 bytes), PDF de hasta
# 3 MB (3145728 bytes) y máximo 10 por documento
DOCUMENTO_ADJUNTO_MAX_BYTES=5242880
DOCUMENTO_PDF_MAX_BYTES=3145728
DOCUMENTO_ADJUNTOS_MAX=10

# Correo (PHPMailer SMTP; en Gmail usar contraseña de aplicación)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Semillero SIIIS"

# Cloudinary (fotos de perfil y adjuntos de documentos). Las pruebas de integración suben a siiis_test/.
# La cuenta debe tener activado "Allow delivery of PDF and ZIP files" (Settings > Security) para los PDF.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PERFILES_FOLDER=siiis/perfiles
CLOUDINARY_DOCUMENTOS_FOLDER=siiis/documentos
# Optimización de espacio (DEC-B42, PROPUESTA). Se aplica al subir: Cloudinary guarda solo el resultado.
# Foto de perfil: recorte cuadrado de PERFIL_FOTO_LADO_PX x PERFIL_FOTO_LADO_PX.
PERFIL_FOTO_LADO_PX=400
# Imágenes adjuntas: ancho máximo, sin agrandar las más pequeñas. Los PDF se guardan tal cual.
DOCUMENTO_IMAGEN_MAX_ANCHO_PX=1600
# Calidad al subir: auto, auto:best, auto:good, auto:eco, auto:low o 1-100.
# Al responder, la API entrega las imágenes con f_auto,q_auto.
CLOUDINARY_CALIDAD=auto
