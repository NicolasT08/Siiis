# Mismos nombres que el backend PHP: un solo .env sirve a los dos.
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8001
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas (obligatorio)
MONGO_URI=
MONGO_DB_NAME=siiis
MONGO_DB_NAME_TEST=siiis_test

# JWT / sesión (JWT_SECRET obligatorio, mínimo 32 caracteres)
JWT_SECRET=
JWT_TTL_SECONDS=28800
MAX_LOGIN_ATTEMPTS=5

# Contraseñas y recuperación
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/restablecer

# Rate limiting por IP
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_FORGOT_WINDOW_SECONDS=3600

# Home
HOME_MAX_ITEMS=20

# Correo (SMTP Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Semillero SIIIS"

# Cloudinary (fuera del alcance de la fase 1)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
