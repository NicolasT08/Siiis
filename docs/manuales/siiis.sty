\fancyfoot[R]{\small\color{siiisgris}P\'agina \thepage\ de \pageref*{LastPage}}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{siiisdorado}\leaders\hrule height \headrulewidth\hfill}}
