\renewcommand{\footrule}{\hbox to\headwidth{\color{siiisazul}\leaders\hrule height \footrulewidth\hfill}}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[R]{\small\color{siiisgris}P\'agina \thepage\ de \pageref*{LastPage}}%
