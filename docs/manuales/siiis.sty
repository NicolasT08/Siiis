% ---------------------------------------------------------------------------------------------------------------
% Datos del documento (se definen en cada main.tex con \siiisdatos)
% ---------------------------------------------------------------------------------------------------------------
\newcommand{\siiisnombre}{Documento}
\newcommand{\siiiscodigo}{}
\newcommand{\siiisversion}{1.0}
\newcommand{\siiisfecha}{\today}
\newcommand{\siiisautor}{Equipo de Desarrollo SIIIS}
% \siiisdatos{Nombre del documento}{Codigo}{Version}{Fecha}
\newcommand{\siiisdatos}[4]{%
  \renewcommand{\siiisnombre}{#1}%
  \renewcommand{\siiiscodigo}{#2}%
  \renewcommand{\siiisversion}{#3}%
  \renewcommand{\siiisfecha}{#4}%
  \hypersetup{pdftitle={#1},pdfauthor={Equipo de Desarrollo SIIIS}}%
}

% ---------------------------------------------------------------------------------------------------------------
% Encabezados y pies
% ---------------------------------------------------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{siiisazul}\textbf{SIIIS V3}}
\fancyhead[R]{\small\color{siiisgris}\siiisnombre}
