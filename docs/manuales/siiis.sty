% ---------------------------------------------------------------------------------------------------------------
% Portada: fondo azul oscuro con franja dorada
% ---------------------------------------------------------------------------------------------------------------
% \siiisportada{Titulo del documento}{Subtitulo}
\newcommand{\siiisportada}[2]{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{tikzpicture}[remember picture,overlay]
      \fill[siiisazul] (current page.south west) rectangle (current page.north east);
      \fill[siiisdorado] ([yshift=-7.2cm]current page.north west) rectangle ([yshift=-7.9cm]current page.north east);
      \fill[siiisazulmedio] (current page.south west) rectangle ([yshift=3.2cm]current page.south east);
      \fill[siiisdorado] ([yshift=3.2cm]current page.south west) rectangle ([yshift=3.35cm]current page.south east);
      \node[anchor=north west,text width=15cm,align=left,text=white] at ([xshift=2.5cm,yshift=-2.6cm]current page.north west)
        {\fontsize{14}{18}\selectfont\bfseries SIIIS --- Semillero de Investigaci\'on, Innovaci\'on\\[2pt] e Ingenier\'ia de Sistemas};
      \node[anchor=north west,text width=15cm,align=left,text=siiisdorado] at ([xshift=2.5cm,yshift=-4.6cm]current page.north west)
        {\large Escuela de Ingenier\'ia de Sistemas y Computaci\'on\\ Universidad Pedag\'ogica y Tecnol\'ogica de Colombia (UPTC)};
      \node[anchor=north west,text width=15cm,align=left,text=white] at ([xshift=2.5cm,yshift=-9.6cm]current page.north west)
        {\fontsize{30}{36}\selectfont\bfseries #1};
      \node[anchor=north west,text width=15cm,align=left,text=white] at ([xshift=2.5cm,yshift=-13.4cm]current page.north west)
        {\Large #2};
      \node[anchor=south west,text width=15cm,align=left,text=white] at ([xshift=2.5cm,yshift=0.9cm]current page.south west)
        {\small\begin{tabular}{@{}ll@{}}
          \textcolor{siiisdorado}{\textbf{C\'odigo:}} & \siiiscodigo\\
          \textcolor{siiisdorado}{\textbf{Versi\'on:}} & \siiisversion\\
          \textcolor{siiisdorado}{\textbf{Fecha:}} & \siiisfecha\\
          \textcolor{siiisdorado}{\textbf{Elaborado por:}} & \siiisautor\\
        \end{tabular}};
    \end{tikzpicture}
  \end{titlepage}
}

