% ---------------------------------------------------------------------------------------------------------------
% Utilidades de texto
% ---------------------------------------------------------------------------------------------------------------
% Codigo en linea (nombres de variables, rutas, comandos cortos). Con el paquete underscore, el guion bajo se
% escribe sin escaparlo; las llaves se escriben \{ \} y la barra invertida \textbackslash.
\newcommand{\cod}[1]{\texttt{#1}}
% Recuadros de aviso
\newcommand{\siiisrecuadro}[3]{% color, titulo, texto
  \par\medskip\noindent
  \fcolorbox{#1}{siiisfondo}{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
    \textbf{\textcolor{#1}{#2}}\par\smallskip #3}}\par\medskip}
\newcommand{\nota}[1]{\siiisrecuadro{siiisazulmedio}{Nota}{#1}}
\newcommand{\importante}[1]{\siiisrecuadro{siiisdorado!80!black}{Importante}{#1}}

% ---------------------------------------------------------------------------------------------------------------
% Capturas de pantalla con respaldo: si el archivo no existe, se dibuja un recuadro "Captura pendiente"
% y el documento compila igual. Busca en img/ y en <carpeta del manual>/img/ (Overleaf compila desde la raiz).
% ---------------------------------------------------------------------------------------------------------------
\newcommand{\siiiscarpeta}{.}
\newcommand{\capturapendiente}[2]{%
  \fcolorbox{siiisgris}{siiisfondo}{\parbox[c][#2][c]{\dimexpr0.86\linewidth\relax}{\centering
    \textcolor{siiisgris}{\Large\bfseries Captura pendiente}\\[4pt]
    \textcolor{siiisgris}{\small\texttt{img/\detokenize{#1}}}}}}
% \captura[ancho]{archivo.png}{Pie de figura}
\newcommand{\captura}[3][0.9\linewidth]{%
  \begin{figure}[H]
    \centering
    \IfFileExists{img/#2}{\includegraphics[width=#1,keepaspectratio]{img/#2}}{%
      \IfFileExists{\siiiscarpeta/img/#2}{\includegraphics[width=#1,keepaspectratio]{\siiiscarpeta/img/#2}}{%
        \capturapendiente{#2}{4.2cm}}}
    \caption{#3}
  \end{figure}}

% ---------------------------------------------------------------------------------------------------------------
% Listados de codigo: bash, PowerShell, PHP, JSON y TypeScript
% ---------------------------------------------------------------------------------------------------------------
\lstdefinelanguage{PowerShell}{
  morekeywords={if,else,elseif,foreach,for,while,function,param,return,try,catch,finally,in,
    Copy-Item,Set-Location,Get-ChildItem,New-Item,Remove-Item,Write-Host},
  sensitive=false,
  morecomment=[l]{\#},
  morestring=[b]",
  morestring=[b]',
}
\lstdefinelanguage{JSON}{
  morestring=[b]",
  stringstyle=\color{siiisazulmedio},
}
\lstdefinelanguage{TypeScript}{
  morekeywords={const,let,var,function,return,if,else,for,while,new,await,async,import,from,export,default,
    type,interface,extends,implements,class,true,false,null,undefined},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]',
  morestring=[b]",
  morestring=[b]`,
}
\lstset{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{siiiscodigo},
  frame=leftline,
  framerule=2.5pt,
  rulecolor=\color{siiisdorado},
  xleftmargin=8pt,
  framexleftmargin=6pt,
  keywordstyle=\color{siiisazul}\bfseries,
  commentstyle=\color{siiisgris}\itshape,
  stringstyle=\color{siiisazulmedio},
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  tabsize=2,
  upquote=true,
  aboveskip=0.8em,
  belowskip=0.8em,
  extendedchars=true,
  literate=
    {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
    {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
    {ñ}{{\~n}}1 {Ñ}{{\~N}}1 {ü}{{\"u}}1 {¿}{{	extquestiondown}}1 {¡}{{	extexclamdown}}1,
}
